{
  "name": "turkish-omr",
  "private": true,
  "version": "0.0.0",
  "description": "Classical Turkish Music OMR \u2014 shared TS core + web test harness (mobile is the product)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run -ws --if-present typecheck",
    "build": "npm run -ws --if-present build",
    "dev:web": "npm run -w @turkish-omr/web dev",
    "test": "npx tsx tools/render/stitch-test.ts && npx tsx tools/core/edits-test.ts",
    "gate:browser": "npx tsx tools/browser/run-page.ts omr-gate.html __gateResult --timeout 600000 --expect 27/28",
    "probe:cv": "npx tsx tools/browser/run-page.ts cv-probe.html __cvProbe",
    "check:logprobs": "npx tsx tools/browser/run-page.ts logprob-check.html __logprobCheck --timeout 600000",
    "smoke:app": "npx tsx tools/browser/app-smoke.ts",
    "smoke:editor": "npx tsx tools/browser/editor-smoke.ts",
    "smoke:page": "npx tsx tools/browser/page-smoke.ts",
    "smoke:build": "npx tsx tools/browser/build-smoke.ts",
    "smoke:live": "npx tsx tools/browser/live-smoke.ts",
    "build:app": "npm run -w @turkish-omr/web build",
    "parity:armb": "npx tsx tools/vision/parity/arm-b.ts",
    "parity:arma": "npx tsx tools/vision/parity/arm-a.ts",
    "parity:slicer": "npx tsx tools/vision/parity/slicer-parity.ts",
    "check:edge": "npx tsx tools/vision/parity/edge-cases.ts",
    "decode:pool": "npx tsx tools/vision/parity/decode-pool.ts",
    "check:deskew": "npx tsx tools/vision/parity/deskew-check.ts",
    "parity:server": "npx tsx tools/vision/parity/server-parity.ts",
    "dev:server": "npm run -w @turkish-omr/server dev",
    "bench:server": "npx tsx tools/vision/parity/server-bench.ts",
    "check:limits": "npx tsx tools/vision/parity/server-limits.ts",
    "check:bundle": "npm run -w @turkish-omr/server check:bundle"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  }
}
